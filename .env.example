# Jev (risk eval) + Architect — both go through OpenRouter
OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest

# Copy to .env and set your Atlas driver URI. Never commit credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=immune_harness
# Ledger rows expire this many seconds after ts (7 days).
LEDGER_TTL_SECONDS=604800
MONGODB_TIMEOUT_MS=5000

# Optional, used only by opt-in integration tests. Must support change streams.
# MONGODB_TEST_URI=mongodb://localhost:27017/?replicaSet=rs0
